# Скопируйте в .env и заполните. Файл .env не коммитится.
POSTGRES_PASSWORD=myHardPass007
KEYCLOAK_ADMIN_PASSWORD=admin007

# Внутренний адрес Keycloak в сети docker-compose
KEYCLOAK_URL=https://keycloak:8443
KEYCLOAK_REALM=inference
KEYCLOAK_VERIFY_SSL=false

# Client ID и Client secret клиента inference-client (Keycloak → Clients → inference-client → Credentials)
CLIENT_ID=inference-client
CLIENT_SECRET=paste-inference-client-secret-here

# Логин DockerHub: используется в именах образов
DOCKERHUB_USERNAME=local
